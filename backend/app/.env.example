# Diabetes RAG Configuration
# Copy this to .env and fill in values.
# NEVER commit .env with real credentials.

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# Retrieval
TOP_K=8
RERANK_TOP_K=15
SIMILARITY_THRESHOLD=0.35
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
DENSE_WEIGHT=0.6

# LLM — Auto provider chain
# Chain order: Gemini → Groq → OpenRouter → graceful refusal
# "auto" = use first configured provider; "gemini"/"groq"/"openrouter" = force one
LLM_PROVIDER=auto

# Gemini API (free tier: 15 RPM)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Groq API (free tier: 30 RPM)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter API (fallback)
LLM_MODEL=openai/gpt-oss-20b:free
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=your-openrouter-api-key-here

# Logging
LOG_LEVEL=INFO
